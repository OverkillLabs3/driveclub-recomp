{
  "$schema": "../../mod.schema.json",
  // The id is unique: a-z, 0-9, '.', '-' and '_'.
  "id": "example.hot-hatch",
  "name": "Hot Hatch (example)",
  "version": "1.0",
  "author": "DriveClub Recomp",
  "description": "Example mod: more power for the Mercedes A45 AMG, a renamed menu text, and no lens dust. Shows table, text, XML-in-pack and file patches.",
  "game": "1.28",

  // Files in the files/ folder are copied to the same path in the game (here data/mods/hot-hatch-readme.txt).
  "patches": [
    // 1. Table cells. Only these cells of newdata/vehicles.csv change.
    {
      "op": "csv.set",
      "file": "newdata/vehicles.csv",
      "key": "Vehicle Name",
      "match": "a45_amg",
      "set": { "TopSpeed": 320, "HorsePower_BHP": 520, "Torque_Nm": 600 }
    },

    // 2. Text. Line breaks and encoding of the language file are kept.
    {
      "op": "text.replace",
      "file": "gui/lams/english.csv",
      "find": "Solo Time Trial Challenge",
      "replace": "Solo Time Attack"
    },

    // 3. XML inside a resource pack. The rest of global.rpk is untouched.
    {
      "op": "rpk.patch",
      "file": "global.rpk",
      "resource": "viewportquality.xml",
      "ops": [
        {
          "op": "xml.set",
          "path": "ViewportQuality/Configuration[@name='default']/General",
          "attr": "lensdust",
          "value": "false"
        }
      ]
    }
  ]
}
