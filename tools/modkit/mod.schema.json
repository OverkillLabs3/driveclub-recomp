{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DriveClub Recomp mod manifest (mod.json)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+$",
      "description": "Unique id: a-z, 0-9, '.', '-', '_'."
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "description": "Dotted numbers, for example 1.2.0."
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "game": {
      "type": "string",
      "description": "Game version the mod was made for, for example 1.28."
    },
    "files": {
      "type": "string",
      "description": "Folder with loose files, relative to the mod."
    },
    "requires": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string",
                "description": "such as >=1.2"
              },
              "optional": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "after": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "before": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string",
      "description": "What the mod is for: Car, Track, Livery, Graphics, Physics, Script, Audio, Tour, or another word."
    },
    "scripts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Lua files (game paths) that run at start-up. Source files are compiled by the build."
    },
    "settings": {
      "type": "object",
      "description": "Choices the player can change. Patches use { \"$setting\": name }, scripts use dcmod.setting(mod, name).",
      "additionalProperties": {
        "type": "object",
        "required": ["default"],
        "properties": {
          "label": { "type": "string" },
          "type": { "enum": ["number", "bool", "string", "choice"] },
          "default": {},
          "min": { "type": "number" },
          "max": { "type": "number" },
          "choices": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "patches": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/patch"
      }
    }
  },
  "definitions": {
    "contentOp": {
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "enum": [
            "text.replace",
            "text.insert",
            "text.append",
            "text.prepend",
            "csv.set",
            "csv.add",
            "csv.remove",
            "xml.set",
            "xml.remove",
            "xml.insert",
            "json.merge",
            "bytes.patch",
            "bytes.replace",
            "lua.const",
            "lua.alias"
          ]
        },
        "comment": {
          "type": "string"
        },
        "top": {
          "type": "string",
          "description": "tex.set: the top mips pack of a texture whose largest levels are in one."
        },
        "optional": {
          "type": "boolean"
        },
        "each": {
          "description": "A pattern ('*' and '?') or list of patterns for game paths: the patch is repeated for every file that matches, with file set to it. {name} in a text of the patch is the file's name without folder and extension, {file} its whole path.",
          "oneOf": [ { "type": "string" }, { "type": "array", "items": { "type": "string" } } ]
        },
        "except": {
          "description": "With each: patterns of files to leave out.",
          "oneOf": [ { "type": "string" }, { "type": "array", "items": { "type": "string" } } ]
        },
        "find": {},
        "replace": {},
        "regex": {
          "type": "string"
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1
        },
        "all": {
          "type": "boolean"
        },
        "after": {
          "type": "string"
        },
        "before": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "match": {},
        "where": {
          "type": "object"
        },
        "set": {
          "type": "object"
        },
        "row": {
          "type": "object"
        },
        "like": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "attr": {
          "type": "string"
        },
        "value": {},
        "remove_attr": {
          "type": "string"
        },
        "raw": {
          "type": "boolean"
        },
        "xml": {
          "type": "string"
        },
        "offset": {},
        "expect": {},
        "write": {
          "type": "string"
        },
        "function": {
          "type": "string"
        }
      }
    },
    "patch": {
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "enum": [
            "file.set",
            "file.copy",
            "text.replace",
            "text.insert",
            "text.append",
            "text.prepend",
            "csv.set",
            "csv.add",
            "csv.remove",
            "xml.set",
            "xml.remove",
            "xml.insert",
            "json.merge",
            "bytes.patch",
            "bytes.replace",
            "lua.const",
            "lua.alias",
            "rpk.set",
            "rpk.patch",
            "rpk.add",
            "rpk.remove",
            "tex.set",
            "vdef.clone",
            "vdef.set",
            "manifest.add",
            "rpk.rename",
            "rpk.copy",
            "rpk.replace",
            "light.set",
            "custom.set",
            "archive.register"
          ],
          "description": "The operation. See docs/modding/patches.md."
        },
        "comment": {
          "type": "string"
        },
        "optional": {
          "type": "boolean",
          "description": "A failure of this patch becomes a warning."
        },
        "file": {
          "type": "string",
          "description": "Game path of the file to change."
        },
        "from": {
          "type": "string",
          "description": "A file in the mod (or for file.copy a game path)."
        },
        "text": {
          "type": "string"
        },
        "find": {},
        "hash": {
          "type": "string",
          "enum": ["crc32"],
          "description": "rpk.replace: find and replace are names; the CRC32 of the first is replaced by the CRC32 of the second."
        },
        "replace": {},
        "regex": {
          "type": "string"
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1
        },
        "all": {
          "type": "boolean"
        },
        "after": {
          "type": "string"
        },
        "before": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "match": {},
        "where": {
          "type": "object"
        },
        "set": {
          "type": "object"
        },
        "row": {
          "type": "object"
        },
        "like": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "attr": {
          "type": "string"
        },
        "value": {},
        "remove_attr": {
          "type": "string"
        },
        "raw": {
          "type": "boolean"
        },
        "xml": {
          "type": "string"
        },
        "offset": {},
        "expect": {},
        "write": {
          "type": "string"
        },
        "function": {
          "type": "string"
        },
        "resource": {
          "type": "string",
          "description": "A resource name or 16 digit hex id inside the pack."
        },
        "ops": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/contentOp"
          }
        },
        "type": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version": {
          "type": "integer"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": "string"
        }
      }
    }
  }
}