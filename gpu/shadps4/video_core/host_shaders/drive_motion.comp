// Camera motion vectors from the scene depth and the game's own view-projection matrices
// (the constants of its temporal anti-aliasing pass): pixels, previous minus current.
#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D depth_tex; // reversed Z: 1 at the near plane, 0 far away
layout(binding = 1, rg16f) uniform writeonly image2D motion_img;
layout(binding = 2) uniform utexture2D mask_tex; // stencil of the scene depth
layout(binding = 3) uniform texture2D object_tex; // rg=pixel motion, b=valid, a=depth
layout(binding = 4) uniform texture2D color_tex;  // HDR input; bright speculars use camera flow

layout(push_constant) uniform Constants {
    vec2 src_size;          // the game's render size (depth)
    mat4 clip_to_prev_clip; // the game's row-vector matrix, uploaded as stored
    vec2 size;              // render pixels
    vec2 scale;             // output scale: 1 for pixels, 1 / size for screen fractions
    float use_stencil;      // 1: the stencil view is real
    float use_object;       // 1: fuse Driveclub object vectors and highlight-aware camera flow
    float eye_shift;        // VR multiview: the eye's clip x shift (0 for one picture)
    float eye_z22;          // VR multiview: 1 / w is (depth + eye_z22) * eye_inv_near
    float eye_inv_near;
};

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(size.x) || pixel.y >= int(size.y)) {
        return;
    }
    const ivec2 src = ivec2(min((vec2(pixel) + 0.5) / size * src_size, src_size - 1.0));
    const float depth = max(texelFetch(depth_tex, src, 0).r, 1e-7);
    const vec2 uv = (vec2(pixel) + 0.5) / size;
    // VR multiview: the eye's pixels are the centre view's moved by shift / w, the same in the previous frame.
    const float eye_ndc = eye_shift * (depth + eye_z22) * eye_inv_near;
    const vec4 clip = vec4(uv.x * 2.0 - 1.0 - eye_ndc, 1.0 - uv.y * 2.0, depth, 1.0);
    // Stored by rows, read by columns: the matrix is transposed, so G * v is v * M.
    const vec4 prev = clip_to_prev_clip * clip;
    vec2 motion = vec2(0.0);
    if (prev.w > 1e-9) {
        const vec2 prev_ndc = (prev.xy + vec2(eye_ndc, 0.0)) / prev.w;
        const vec2 prev_uv = vec2(prev_ndc.x * 0.5 + 0.5, 0.5 - prev_ndc.y * 0.5);
        motion = (prev_uv - uv) * size;
    }
    // The player's car, the hands and the other cars keep their place on the screen far better than the world does.
    if (use_stencil > 0.5 && (texelFetch(mask_tex, src, 0).r & 130u) != 0u) {
        motion = vec2(0.0);
    }
    if (use_object > 0.5) {
        const vec4 object_motion = texelFetch(object_tex, pixel, 0);
        const float depth_tolerance = max(2.0e-7, abs(depth) * 0.01);
        if (object_motion.b > 0.99 && !any(isnan(object_motion.rg)) &&
            !any(isinf(object_motion.rg)) &&
            abs(object_motion.a - depth) <= depth_tolerance) {
            // Specular highlights do not follow the underlying car surface's motion. Keep
            // the camera field there so their changing reflection does not inherit the car's
            // otherwise-correct rigid motion vector.
            const vec2 vector_delta = motion - object_motion.rg;
            // If the two fields differ by less than 1/16 pixel, their choice is visually
            // indistinguishable. Avoid an HDR texture read for the common near-zero case.
            if (dot(vector_delta, vector_delta) > 0.00390625) {
                const vec3 hdr = texelFetch(color_tex, pixel, 0).rgb;
                const float peak = max(hdr.r, max(hdr.g, hdr.b));
                const float floor = min(hdr.r, min(hdr.g, hdr.b));
                const float chroma = (peak - floor) / max(peak, 1e-4);
                // Bright, nearly neutral pixels are usually reflected light. Their apparent
                // position follows the environment rather than the car surface. Fade toward
                // camera flow there instead of switching vectors abruptly at a hard threshold.
                const float highlight = smoothstep(0.65, 1.8, peak);
                const float neutral = 1.0 - smoothstep(0.15, 0.6, chroma);
                motion = mix(object_motion.rg, motion, highlight * neutral);
            } else {
                motion = object_motion.rg;
            }
        }
    }
    imageStore(motion_img, pixel, vec4(motion * scale, 0.0, 0.0));
}
