// Camera motion vectors from the scene depth and the game's own view-projection matrices
// (the constants of its temporal anti-aliasing pass): pixels, previous minus current.
#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D depth_tex; // reversed Z: 1 at the near plane, 0 far away
layout(binding = 1, rg16f) uniform writeonly image2D motion_img;
layout(binding = 2) uniform utexture2D mask_tex; // stencil of the scene depth
layout(binding = 3) uniform texture2D object_tex; // rg=pixel motion, b=valid, a=depth
layout(binding = 4) uniform texture2D color_tex;  // HDR input; bright speculars use camera flow
layout(binding = 5) uniform texture2D native_tex; // native rigid history

layout(push_constant) uniform Constants {
    vec2 src_size;          // the game's render size (depth)
    mat4 clip_to_prev_clip; // the game's row-vector matrix, uploaded as stored
    vec2 size;              // render pixels
    vec2 scale;             // output scale: 1 for pixels, 1 / size for screen fractions
    vec2 jitter;            // current viewport shift in render pixels (x right, y down)
    float use_native;
    float use_color;
    float use_stencil;      // 1: the stencil view is real
    float use_object;       // 1: the G-buffer object motion image is valid this frame
    uint stencil_mask;      // bits of the stencil that mark screen-static foreground
    float near_depth;       // reversed-Z depth of screen-static geometry (0 = off)
};

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(size.x) || pixel.y >= int(size.y)) {
        return;
    }
    const ivec2 src = ivec2(min((vec2(pixel) + 0.5) / size * src_size, src_size - 1.0));
    const float depth = max(texelFetch(depth_tex, src, 0).r, 1e-7);
    const vec2 uv = (vec2(pixel) + 0.5) / size;
    // The scene was rasterised through a shifted viewport. Compute the camera vector for the
    // unjittered position, as the game's own TAA/FSR motion does; otherwise every frame carries
    // a ~0.5 px motion error that DLSS/FSR turn into shimmer.
    const vec2 scene_uv = uv - jitter / src_size;
    const vec4 clip = vec4(scene_uv.x * 2.0 - 1.0, 1.0 - scene_uv.y * 2.0, depth, 1.0);
    // Stored by rows, read by columns: the matrix is transposed, so G * v is v * M.
    const vec4 prev = clip_to_prev_clip * clip;
    vec2 motion = vec2(0.0);
    if (prev.w > 1e-9) {
        const vec2 prev_ndc = prev.xy / prev.w;
        const vec2 prev_uv = vec2(prev_ndc.x * 0.5 + 0.5, 0.5 - prev_ndc.y * 0.5);
        motion = (prev_uv - scene_uv) * size;
    }
    // Object draws matched between frames carry their own previous position. Use it when the
    // stored depth still matches this pixel; otherwise the camera vector is the only valid one.
    const vec2 camera_motion = motion;
    bool object_used = false;
    if (use_object > 0.5) {
        const vec4 object_motion = texelFetch(object_tex, src, 0);
        const float threshold = max(depth * 1e-6, 1e-10);
        if (object_motion.b > 0.99 && abs(object_motion.a - depth) < threshold &&
            !any(isnan(object_motion.rg)) && !any(isinf(object_motion.rg))) {
            motion = object_motion.rg * size / src_size;
            const vec2 vector_delta = camera_motion - motion;
            if (use_color > 0.5 && dot(vector_delta, vector_delta) > 0.00390625) {
                const vec3 hdr = texelFetch(color_tex, src, 0).rgb;
                const float peak = max(hdr.r, max(hdr.g, hdr.b));
                const float floor = min(hdr.r, min(hdr.g, hdr.b));
                const float chroma = (peak - floor) / max(peak, 1e-4);
                // Bright neutral reflections follow the environment, rather than the car surface.
                const float highlight = smoothstep(0.65, 1.8, peak);
                const float neutral = 1.0 - smoothstep(0.15, 0.6, chroma);
                motion = mix(motion, camera_motion, highlight * neutral);
            }
            object_used = true;
        }
    }
    if (!object_used && use_native > 0.5) {
        const vec4 native_motion = texelFetch(native_tex, src, 0);
        if (native_motion.b > 0.99 &&
            abs(native_motion.a - depth) < max(depth * 1e-6, 1e-10) &&
            !any(isnan(native_motion.rg)) && !any(isinf(native_motion.rg))) {
            motion = native_motion.rg * size / src_size;
            object_used = true;
        }
    }
    // The stencil marks the player's car and hands, which keep their screen position. Do not
    // override a real object vector that the G-buffer matched for the same pixel.
    if (!object_used &&
        ((use_stencil > 0.5 && (texelFetch(mask_tex, src, 0).r & stencil_mask) != 0u) ||
         (near_depth > 0.0 && depth > near_depth))) {
        motion = vec2(0.0);
    }
    imageStore(motion_img, pixel, vec4(motion * scale, 0.0, 0.0));
}
